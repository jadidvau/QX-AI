<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer delicate glow -->
    <path
        android:fillColor="#10FFFFFF"
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0" />

    <!-- Circular red-to-green gradient boundary track (properly padded in safe area) -->
    <path
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M54,22 A32,32 0 1,1 53.99,22">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="54"
                android:endX="86"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3366" /> <!-- Red -->
                <item android:offset="1.0" android:color="#00E676" /> <!-- Green -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Candlestick indicators on the left (Red) -->
    <path
        android:fillColor="#FF3366"
        android:pathData="M28,44h2v8h-2z" />
    <path
        android:strokeColor="#FF3366"
        android:strokeWidth="0.6"
        android:pathData="M29,39v18" />

    <!-- Candlestick indicators on the right (Green) -->
    <path
        android:fillColor="#00E676"
        android:pathData="M78,40h2v8h-2z" />
    <path
        android:strokeColor="#00E676"
        android:strokeWidth="0.6"
        android:pathData="M79,35v18" />

    <!-- Stylized text 'AI' in center of vector -->
    <!-- Draw letter 'A' -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,58 L45,40 L49,40 L54,58 L50,58 L48,51 L43,51 L41,58 Z M44,47 L47,47 L46,43 Z" />
        
    <!-- Draw letter 'I' -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,40 L62,40 L62,58 L57,58 Z" />

    <!-- Green Sweep Arrow trending up -->
    <path
        android:strokeColor="#00E676"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,62 C42,59 52,54 65,34" />
    <path
        android:fillColor="#00E676"
        android:pathData="M65,34 L58,35 L62,39 Z" />

    <!-- Thin white separator inside the icon -->
    <path
        android:strokeColor="#20FFFFFF"
        android:strokeWidth="0.5"
        android:pathData="M42,66h24" />

    <!-- Bull (Green) & Bear (Red) miniature emojis/circles -->
    <path
        android:fillColor="#00E676"
        android:pathData="M44,70a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0" />
    <path
        android:fillColor="#FF3366"
        android:pathData="M61,70a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0" />

</vector>
